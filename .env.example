# ─────────────────────────────────────────────
# Core — required to start the server
# ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# Comma-separated list of allowed frontend origins for CORS.
# In production set this to your Vercel URL, e.g. https://project-smm.vercel.app
CORS_ORIGIN=http://localhost:5173

# Public URL of THIS backend (used to build OAuth callback URLs).
# In production set to your Railway URL, e.g. https://project-smm.up.railway.app
PUBLIC_BACKEND_URL=http://localhost:3000

# OPTION A — Docker Compose (run: docker-compose up -d in project root)
DATABASE_URL=postgresql://smm:smm_dev_pass@localhost:5432/smm_dev
REDIS_URL=redis://localhost:6379

# OPTION B — Free cloud (no Docker, no credit card)
# Postgres: sign up free at https://neon.tech  (GitHub login works)
#   → New Project → copy the "Connection string" starting with postgres://
# DATABASE_URL=postgres://user:pass@ep-xxx.us-east-2.aws.neon.tech/smm_dev?sslmode=require
# Redis: sign up free at https://upstash.com  (GitHub login works)
#   → Create Database → Redis → copy "UPSTASH_REDIS_URL"
# REDIS_URL=rediss://default:xxx@xxx.upstash.io:6379

# ─────────────────────────────────────────────
# AI — Cerebras is primary (required)
# Get key at: https://cloud.cerebras.ai → API Keys
# ─────────────────────────────────────────────
CEREBRAS_API_KEY=REPLACE_ME
CEREBRAS_MODEL=llama-3.3-70b

# AWS — optional but recommended for production
# For Bedrock (Claude fallback) + SQS (post scheduling):
#   1. Create IAM user with: AmazonBedrockFullAccess, AmazonSQSFullAccess, AmazonS3FullAccess
#   2. Generate access keys and create an SQS queue named "smm-publish-queue"
# Leave blank to use poll loop fallback (slower, local dev only)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SQS_QUEUE_URL=

# ─────────────────────────────────────────────
# Platform OAuth — optional, only needed for live posting
# Each platform section links to where to create the app
# ─────────────────────────────────────────────

# X (Twitter): https://developer.twitter.com/en/portal/dashboard
X_CLIENT_ID=
X_CLIENT_SECRET=

# LinkedIn: https://www.linkedin.com/developers/apps/new
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Facebook / Instagram: https://developers.facebook.com/apps
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# TikTok: https://developers.tiktok.com/
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Bluesky — no app registration needed!
# Use your handle + an App Password from: https://bsky.app/settings/app-passwords
BLUESKY_HANDLE=your-handle.bsky.social
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ─────────────────────────────────────────────
# External integrations — all optional
# ─────────────────────────────────────────────
# Vapi voice AI: https://app.vapi.ai
VAPI_API_KEY=

# Apify web scraping: https://console.apify.com
APIFY_API_TOKEN=

# ─────────────────────────────────────────────
# Security
# ─────────────────────────────────────────────
# Any random 32+ char string for dev. Use a real secret in prod.
ENCRYPTION_KEY=dev-only-key-change-in-prod-min32!

# Session secret for express-session cookies. Use a random 32+ char string in prod.
SESSION_SECRET=dev-session-secret-change-me-in-prod!!

# ─────────────────────────────────────────────
# User Authentication (Google + GitHub social login)
# ─────────────────────────────────────────────
# Google: https://console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client
#   Authorized JS Origins: http://localhost:3000, http://localhost:5173
#   Authorized Redirect URI: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub: https://github.com/settings/developers → OAuth Apps → New
#   Homepage URL: http://localhost:5173
#   Callback URL: http://localhost:3000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
