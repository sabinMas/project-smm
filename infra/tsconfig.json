{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "composite": true,
    "paths": {
      "@smm/shared": ["../shared/src"],
      "@smm/shared/*": ["../shared/src/*"]
    }
  },
  "include": ["*.ts", "src/**/*.ts"],
  "references": [
    { "path": "../shared" }
  ]
}
